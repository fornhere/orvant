  "project": {
    "id": "deney-defteri",
    "name": "Deney Defteri",
    "goal": "Forn ve başka AI kullanıcılarının denemelerini komut, çıktı ve değerlendirmeyle kaydetmesini; iki deneyi karşılaştırıp ne öğrendiğini bulmasını sağlamak.",
    "audience": "Forn ve AI araçlarını deneyerek öğrenen insanlar",
    "scope": [
      "Deney ekleme ve geçmiş deneyleri açma",
      "Deneye metin veya çıktı dosyası bağlama",
      "İki deneyi aynı ölçütlerle yan yana karşılaştırma",
      "İlk kullanılabilir sürümü gerçek kullanıcı denemesiyle değerlendirme"
    ],
    "out_of_scope": [
      "İlk iş paketinde otomatik model çağırma ve otomatik puanlama",
      "İlk iş paketinde sosyal akış ve herkese açık deney havuzu"
    ],
    "constraints": [
      "Kullanıcının kendi deney sonucu ile örnek/kurmaca veri açıkça ayrılır",
      "Başarı iddiaları kayıtlı çıktı ve değerlendirmeye dayanır"
    ],
    "open_questions": [
      "İlk uygulama tarayıcıda mı, masaüstünde mi çalışacak; veriler nerede saklanacak?",
      "Başkalarının yararlanması kendi defterini kullanmakla mı, seçilmiş deneyleri paylaşmakla mı başlayacak?",
      "Dışa aktarma ve yayınlama ilk sürüme eklenecek mi?"
    ]
  },
